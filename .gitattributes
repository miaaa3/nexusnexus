# Normalise line endings — same diff on macOS / Linux / Windows.
* text=auto eol=lf

# Force LF for source code (so contributors on Windows don't see CRLF noise).
*.java       text eol=lf
*.kt         text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.html       text eol=lf
*.scss       text eol=lf
*.css        text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.xml        text eol=lf

# Shell scripts must be LF or they break on Linux.
*.sh         text eol=lf
mvnw         text eol=lf

# Windows-specific should stay CRLF.
*.bat        text eol=crlf
*.cmd        text eol=crlf
mvnw.cmd     text eol=crlf

# Binary — never touch.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.tar.gz     binary
*.osm        binary
*.pbf        binary
